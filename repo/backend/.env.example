# Backend runtime
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
COOKIE_DOMAIN=localhost

# Database and cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/crypto_dashboard?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Password hashing
ARGON2_TIME_COST=12
ARGON2_MEMORY_COST=65536

# Web Push (optional in local development)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# CoinGecko
# Uses the public endpoint anonymously; no API key is required.

# Development toggles (optional)
# /api/dev/* endpoints load only when NODE_ENV=development
DISABLE_THROTTLE=0
DISABLE_BINANCE_PROXY=0
